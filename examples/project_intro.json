            { "text": "builder：Presentation JSON 编译为 OOXML", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "text": "svgdecode：SVG 转原生矢量元素", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "text": "renderer：LibreOffice / 浏览器截图 / 结构化降级", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "text": "template：现有 .pptx 设计 DNA 提取", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" }
