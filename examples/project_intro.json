            { "text": "7 种风格预设（swiss_minimal / dark_tech 等）", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "text": "8 套色板（tech_neon / cool_corporate 等）", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "text": "风格与色板组合成设计锁", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "space_after": 12 },
