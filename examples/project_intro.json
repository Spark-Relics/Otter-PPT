            { "text": "Vision 回评：渲染截图到视觉模型修正", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" },
            { "text": "AutoLayout：18 布局模板 + 溢出自动修复", "style": { "font_size": 14, "color": "#CBD5E1" }, "bullet": "•" }
          ]
